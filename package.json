{
  "name": "projeto-turbo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply projeto-turbo --local",
    "db:remote": "wrangler d1 migrations apply projeto-turbo --remote",
    "deploy": "npm run build && wrangler deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "setup:cloud": "node scripts/setup-cloud.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0",
    "@types/node": "^22.15.0"
  }
}
